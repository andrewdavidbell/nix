# ~/.aws/config
# AWS SSO configuration (not managed by Nix)
#
# Copy this file to ~/.aws/config and update with your AWS details.
# Login with: aws sso login --profile <profile-name>

###############################################################################
# SSO Session
###############################################################################
[sso-session personal]
sso_start_url = https://d-xxxxxxxxxx.awsapps.com/start
sso_region = ap-southeast-2
sso_registration_scopes = sso:account:access

###############################################################################
# Profiles
###############################################################################
[profile personal-admin]
sso_session = personal
sso_account_id = 123456789012
sso_role_name = AdministratorAccess
region = ap-southeast-2
output = json

[profile personal-readonly]
sso_session = personal
sso_account_id = 123456789012
sso_role_name = ReadOnlyAccess
region = ap-southeast-2
output = json

[profile work-dev]
sso_session = work
sso_account_id = 987654321098
sso_role_name = DeveloperAccess
region = us-east-1
output = json

###############################################################################
# Alternative: IAM credentials (less secure, avoid if possible)
###############################################################################
# [profile legacy]
# aws_access_key_id = AKIA...
# aws_secret_access_key = ...
# region = us-east-1
